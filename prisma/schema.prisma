// Vercel дээр Postgres (Prisma Postgres, Neon, Supabase ...) холбоход DATABASE_URL автоматаар нэмэгдэнэ.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  bio          String   @default("")
  avatar       String?  // жижигрүүлсэн JPEG data URL
  avatarAt     DateTime?
  googleId     String?
  isAdmin      Boolean  @default(false)
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastSeen     DateTime @default(now())
  premiumZh    DateTime? // Хятад хэлний багц дуусах огноо
  premiumEn    DateTime? // Англи хэлний багц дуусах огноо

  progress      Progress?
  posts         Post[]
  comments      Comment[]
  reactions     Reaction[]
  messages      ChatMessage[]
  sentRequests  Friend[]       @relation("FriendFrom")
  gotRequests   Friend[]       @relation("FriendTo")
  notifications Notification[]
  blocks        Block[]        @relation("Blocker")
  blockedBy     Block[]        @relation("Blocked")
  reports       Report[]
  resets        PasswordReset[]
  stories       Story[]
  duelsSent     Duel[]         @relation("DuelFrom")
  duelsGot      Duel[]         @relation("DuelTo")
  pushSubs      PushSub[]
  aiUses        AiUse[]
  orders        Order[]
  chatReactions ChatReaction[]
  storyViews    StoryView[]
  postViews     PostView[]
  actedNotifs   Notification[] @relation("NotifActor")

  @@index([googleId])
}

// Хэрэглэгчийн бүх ахиц JSON хэлбэрээр; тэргүүлэгчдэд зориулж xp/streak/learned тусдаа багана
model Progress {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  xp        Int      @default(0)
  streak    Int      @default(0)
  learned   Int      @default(0)
  track     String   @default("zh")
  xpAt      DateTime @default(now()) // XP хамгийн сүүлд нэмэгдсэн цаг
  xpDay     String   @default("")    // XP тоолсон өдөр (YYYY-MM-DD)
  xpDayGain Int      @default(0)     // тухайн өдөр нэмэгдсэн XP
  updatedAt DateTime @updatedAt

  @@index([xp])
}

model Post {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  image     String?
  createdAt DateTime   @default(now())
  comments  Comment[]
  reactions Reaction[]
  views     PostView[]

  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Reaction {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String // like | love | wow

  @@unique([postId, userId, kind])
}

// room: "public" | "zh" | "en" | "dm:<id1>:<id2>"
model ChatMessage {
  id        String   @id @default(cuid())
  room      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  image     String?  // жижигрүүлсэн JPEG data URL
  system    Boolean  @default(false) // системийн баяр хүргэлт
  pinned    Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now())
  reactions ChatReaction[]

  @@index([room, createdAt])
}

// Чатын мессежид ❤️ дарсан хүмүүс
model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
}

// Сторй, пост үзсэн хүмүүс
model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Friend {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("FriendFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("FriendTo", fields: [toId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending | accepted
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  link      String   @default("")
  actorId   String?
  actor     User?    @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// Хэрэглэгчийн мэдээлэл (report): kind = post | comment | chat | user
model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  kind       String
  targetId   String
  reason     String   @default("")
  preview    String   @default("")
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([resolved, createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 24 цагийн сторй
model Story {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  image     String?
  text      String   @default("")
  bg        String   @default("#0a0a0a")
  createdAt DateTime @default(now())
  views     StoryView[]

  @@index([createdAt])
}

// Найзуудын үгийн тулаан (duel)
model Duel {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("DuelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("DuelTo", fields: [toId], references: [id], onDelete: Cascade)
  course    String
  level     String
  questions Json
  fromScore Int?
  toScore   Int?
  status    String   @default("pending") // pending | done | declined
  createdAt DateTime @default(now())

  @@index([toId, status])
}

model PushSub {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Хиймэл оюуны хэрэглээ (өдрийн хязгаар)
model AiUse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Серверийн тохиргоо (жишээ нь web push-ийн VAPID түлхүүр)
model Setting {
  key   String @id
  value String
}

// Худалдаалах багц (админ тохируулна). langs: "zh" | "en" | "all"
model Plan {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Int
  months      Int
  langs       String
  active      Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  orders      Order[]
}

// Багц худалдан авах захиалга: данс руу шилжүүлээд админ батална
model Order {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  code      String
  amount    Int
  months    Int
  langs     String
  status    String    @default("pending") // pending | paid | rejected | cancelled
  note      String    @default("")
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
  @@index([code])
}
